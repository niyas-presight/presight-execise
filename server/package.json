    "better-sqlite3": "~11.7.0",
    "express": "~5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "~7.6.12",
    "@types/express": "~5.0.1",
    "@types/node": "~22.15.3",
    "@types/node-fetch": "~2.6.12",
    "tsx": "~4.19.3",
    "typescript": "~5.8.3",
    "vitest": "~3.1.2"
  }
}